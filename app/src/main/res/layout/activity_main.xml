<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="58dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:background="#000000">

        <ImageButton
            android:id="@+id/btnHome" android:layout_width="38dp" android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_today" android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:gravity="center_vertical" android:background="@drawable/bg_omnibox"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShield" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:paddingEnd="8dp" android:text="🛡️ برافو"
                android:textColor="#4CAF50" android:textStyle="bold" android:textSize="13sp" />

            <EditText
                android:id="@+id/urlInput" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@android:color/transparent"
                android:hint="ابحث في Google أو اكتب الرابط..." android:textColor="#FFFFFF"
                android:textColorHint="#666666" android:textSize="14sp"
                android:singleLine="true" android:imeOptions="actionGo" android:inputType="textUri" />

            <TextView
                android:id="@+id/btnReload" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:paddingStart="8dp" android:text="↻"
                android:textColor="#FFFFFF" android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExtensions" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="🧩" android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnTabs" android:layout_width="34dp" android:layout_height="32dp"
            android:layout_marginStart="4dp" android:gravity="center" android:text="1"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"
            android:background="@drawable/bg_omnibox" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp"
        android:max="100" android:progressTint="#FF5722" android:background="#111111" android:visibility="gone" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#151515" />

    <FrameLayout
        android:id="@+id/webViewContainer" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:background="#000000" />
</LinearLayout>
